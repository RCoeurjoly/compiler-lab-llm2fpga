# Deliberately unconstrained probe I/O: this file only supplies electrical
# standards so nextpnr can measure internal resource/timing pressure.  YPCB pin
# LOCs belong to the production wrapper and are not claimed by this probe.
set_property IOSTANDARD LVCMOS18 [get_ports {controller_clk}]
set_property IOSTANDARD LVCMOS18 [get_ports {ddr3_clk}]
set_property IOSTANDARD LVCMOS18 [get_ports {ref_clk}]
set_property IOSTANDARD LVCMOS18 [get_ports {ddr3_clk_90}]
set_property IOSTANDARD LVCMOS18 [get_ports {rst_n}]
set_property IOSTANDARD LVCMOS18 [get_ports {read_valid}]
set_property IOSTANDARD LVCMOS18 [get_ports {read_address[*]}]
set_property IOSTANDARD LVCMOS18 [get_ports {response_valid}]
set_property IOSTANDARD LVCMOS18 [get_ports {response_address[*]}]
set_property IOSTANDARD LVCMOS18 [get_ports {response_data[*]}]
set_property IOSTANDARD LVCMOS18 [get_ports {response_error}]
set_property IOSTANDARD DIFF_SSTL15 [get_ports {ddr3_ck_p}]
set_property IOSTANDARD DIFF_SSTL15 [get_ports {ddr3_ck_n}]
set_property IOSTANDARD SSTL15 [get_ports {ddr3_reset_n}]
set_property IOSTANDARD SSTL15 [get_ports {ddr3_cke}]
set_property IOSTANDARD SSTL15 [get_ports {ddr3_cs_n}]
set_property IOSTANDARD SSTL15 [get_ports {ddr3_ras_n}]
set_property IOSTANDARD SSTL15 [get_ports {ddr3_cas_n}]
set_property IOSTANDARD SSTL15 [get_ports {ddr3_we_n}]
set_property IOSTANDARD SSTL15 [get_ports {ddr3_addr[*]}]
set_property IOSTANDARD SSTL15 [get_ports {ddr3_ba[*]}]
set_property IOSTANDARD SSTL15 [get_ports {ddr3_dq[*]}]
set_property IOSTANDARD DIFF_SSTL15 [get_ports {ddr3_dqs_p[*]}]
set_property IOSTANDARD DIFF_SSTL15 [get_ports {ddr3_dqs_n[*]}]
set_property IOSTANDARD SSTL15 [get_ports {ddr3_odt}]
set_property IOSTANDARD LVCMOS18 [get_ports {calib_complete}]
create_clock -name controller_clk -period 12.000 [get_ports controller_clk]
create_clock -name ddr3_clk -period 3.000 [get_ports ddr3_clk]
set_property IOSTANDARD SSTL15 [get_ports {ddr3_addr[0]}]
