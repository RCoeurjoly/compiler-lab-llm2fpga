r9cwqwy0xdl2m9bqclq2y2-ncurses-6.5-dev /nix/store/23238mplyl5hlfsv0lx477hvibnjv6x1-mlir-23.0.0-unstable-2026-01-20-dev /nix/store/v1fhw8aljxbw0fwlyr3gb04xx5sr8m15-llvm-23.0.0-unstable-2026-01-20-dev"),("buildPhase","runHook preBuild\n\ncmake --build build --target torch-mlir-opt TorchMLIRPythonModules -- -j${NIX_BUILD_CORES:-1}\n\nrunHook postBuild\n"),("builder","/nix/store/rlq03x4cwf8zn73hxaxnx0zn5q9kifls-bash-5.3p3/bin/bash"),("cmakeFlags",""),("configureFlags",""),("configurePhase","  runHook preConfigure\n\n  export PYTHONPATH=\"/nix/store/vd9gbj7pm6famf3kiskqxl1dwkjmh3xh-python3.11-pybind11-3.0.1/lib/python3.11/site-packages:/nix/store/n5s9ncb5sxslpny5kghl74wv98p9dn4v-nanobind-bootstrap-2.10.2/lib/python3.11/site-packages:${PYTHONPATH:-}\"\n  extraCmakeFlags=()\n  # Local forks are often checked out without submodules. Disable stablehlo\n  # in that case so we can still iterate on core torch-mlir code.\n  if [ ! -d externals/stablehlo/stablehlo ]; then\n    extraCmakeFlags+=(-DTORCH_MLIR_ENABLE_STABLEHLO=OFF)\n  fi\n\n  # MLIR's exported config in our split Nix package sets MLIR_TABLEGEN_EXE\n  # to a relative `mlir-tblgen`. Re-point it after find_package(MLIR) so\n  # generated .inc rules depend on an absolute executable path.\n  substituteInPlace CMakeLists.txt \\\n    --replace-fail \"find_package(MLIR REQUIRED CONFIG)\" \\\n    \"find_package(MLIR REQUIRED CONFIG)\nset(MLIR_TABLEGEN_EXE /nix/store/qlkklrgiqi1paa25gpmk02d2sf6hnjc9-llvm-tblgen-23.0.0-unstable-2026-01-20/bin/mlir-tblgen)\nset(MLIR_TABLEGEN_TARGET /nix/store/qlkklrgiqi1paa25gpmk02d2sf6hnjc9-llvm-tblgen-23.0.0-unstable-2026-01-20/bin/mlir-tblgen)\"\n\n  # The embedded StableHLO Python bindings pull in nanobind targets with\n  # Clang-specific warning flags that break our GCC-based Nix build. They\n  # are not needed for this pipeline; only torch-mlir's own Python package\n  # and `torch-mlir-opt` are used.\n  substituteInPlace CMakeLists.txt \\\n    --replace-fail \"set(STABLEHLO_ENABLE_BINDINGS_PYTHON ON)\" \\\n                   \"set(STABLEHLO_ENABLE_BINDINGS_PYTHON OFF)\"\n\n  substituteInPlace python/CMakeLists.txt \\\n    --replace-fail \"if(TORCH_MLIR_ENABLE_STABLEHLO)\" \\\n                   \"if(TORCH_MLIR_ENABLE_STABLEHLO AND STABLEHLO_ENABLE_BINDINGS_PYTHON)\"\n\n  cmake -G Ninja \\\n    -S . \\\n    -B build \\\n    -DCMAKE_BUILD_TYPE=Release \\\n    -DCMAKE_INSTALL_PREFIX=$out \\\n    -DLLVM_ENABLE_ASSERTIONS=ON \\\n    -DMLIR_ENABLE_BINDINGS_PYTHON=ON \\\n    -DMLIR_TABLEGEN_EXE=/nix/store/qlkklrgiqi1paa25gpmk02d2sf6hnjc9-llvm-tblgen-23.0.0-unstable-2026-01-20/bin/mlir-tblgen \\\n    -DLLVM_DIR=/nix/store/v1fhw8aljxbw0fwlyr3gb04xx5sr8m15-llvm-23.0.0-unstable-2026-01-20-dev/lib/cmake/llvm \\\n    -DMLIR_DIR=/nix/store/23238mplyl5hlfsv0lx477hvibnjv6x1-mlir-23.0.0-unstable-2026-01-20-dev/lib/cmake/mlir \\\n    -Dnanobind_DIR=/nix/store/n5s9ncb5sxslpny5kghl74wv98p9dn4v-nanobind-bootstrap-2.10.2/lib/python3.11/site-packages/nanobind/cmake \\\n    -DPython3_EXECUTABLE=/nix/store/00x3abm7y8j13i6n4sahvbar99irkc7d-python3-3.11.14/bin/python3 \\\n    -DPython_EXECUTABLE=/nix/store/00x3abm7y8j13i6n4sahvbar99irkc7d-python3-3.11.14/bin/python3 \\\n    -DPython3_FIND_VIRTUALENV=ONLY \\\n    -DPython_FIND_VIRTUALENV=ONLY \\\n    \"${extraCmakeFlags[@]}\"\n\n  runHook postConfigure\n"),("depsBuildBuild",""),("depsBuildBuildPropagated",""),("depsBuildTarget",""),("depsBuildTargetPropagated",""),("depsHostHost",""),("depsHostHostPropagated",""),("depsTargetTarget",""),("depsTargetTargetPropagated",""),("doCheck",""),("doInstallCheck",""),("installPhase","runHook preInstall\n\nfor component in torch-mlir-headers torch-mlir-opt TorchMLIRPythonModules; do\n  cmake --install build --prefix \"$out\" --component \"$component\"\ndone\n\n# Keep upstream component layout and expose the Python package under the\n# canonical `lib/python3.11/site-packages` path used by this repo.\nif [ -d \"$out/python_packages\" ]; then\n  mv \"$out/python_packages\" \"$out/python-packages\"\nfi\nif [ -d \"$out/python-packages\" ]; then\n  mkdir -p \"$out/lib/python3.11/site-packages\"\n  cp -r \"$out/python-packages/.\" \"$out/lib/python3.11/site-packages/\"\nfi\n\nrunHook postInstall\n"),("mesonFlags",""),("name","torch-mlir-0-unstable-2026-02-12"),("nativeBuildInputs","/nix/store/w9jm660dykns6hzrdhxmqfywnc9ail8g-cmake-4.1.2 /nix/store/nib1r4k4cqph7zjjnbfc1d6cbg11qr76-ninja-1.13.1 /nix/store/8vdiwpbh0g4avsd6x5v4s0di32vcl3dp-pkg-config-wrapper-0.29.2 /nix/store/ky6hkcj7kxsyww2r0ika361ybrg8765g-git-minimal-2.51.2 /nix/store/00x3abm7y8j13i6n4sahvbar99irkc7d-python3-3.11.14 /nix/store/vd9gbj7pm6famf3kiskqxl1dwkjmh3xh-python3.11-pybind11-3.0.1 /nix/store/n5s9ncb5sxslpny5kghl74wv98p9dn4v-nanobind-bootstrap-2.10.2 /nix/store/qlkklrgiqi1paa25gpmk02d2sf6hnjc9-llvm-tblgen-23.0.0-unstable-2026-01-20"),("out","/nix/store/k8smi8mni8mjmyf37dav2lf4f11is7ha-torch-mlir-0-unstable-2026-02-12"),("outputs","out"),("patches","/nix/store/9zcjj5234q29sflh0cms6a5czzhfa35n-legalize-bitwise-right-shift-tensor-scalar.patch"),("pname","torch-mlir"),("propagatedBuildInputs",""),("propagatedNativeBuildInputs",""),("src","/nix/store/6ahfs3ba2jhilx68qwx25bh0yvkdw6k3-source"),("stdenv","/nix/store/s3w5m3spa1g71hx0yb82lvk6394j3w5j-stdenv-linux"),("strictDeps",""),("system","x86_64-linux"),("version","0-unstable-2026-02-12")])