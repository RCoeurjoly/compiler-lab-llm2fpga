+bool BPIFlash::verify(uint32_t addr, const uint8_t *data, uint32_t len)
+{
+	if (!data || !len || (addr & 1) || addr > 64u * 1024 * 1024 ||
+		len > 64u * 1024 * 1024 - addr)
+		throw std::runtime_error("BPI full verification invalid range");
+	std::vector<uint8_t> actual(4096);
+	for (uint32_t offset = 0; offset < len;) {
+		uint32_t chunk = len - offset;
+		if (chunk > actual.size()) chunk = actual.size();
+		try {
+			if (!read(actual.data(), addr + offset, chunk))
+				throw std::runtime_error("read returned failure");
+		} catch (const std::exception &e) {
+			char location[96];
+			snprintf(location, sizeof(location),
+				"BPI full verification read failed at chunk 0x%08x: ", addr + offset);
+			throw std::runtime_error(std::string(location) + e.what());
+		}
+		for (uint32_t i = 0; i < chunk; ++i) {
+			if (actual[i] != data[offset + i]) {
+				char message[160];
+				snprintf(message, sizeof(message),
+					"BPI full verification mismatch at 0x%08x: expected 0x%02x actual 0x%02x",
+					addr + offset + i, data[offset + i], actual[i]);
+				throw std::runtime_error(message);
+			}
+		}
+		offset += chunk;
+	}
+	char message[128];
+	snprintf(message, sizeof(message),
+		"BPI full verification passed: %u bytes at 0x%08x", len, addr);
+	printInfo(message);
+	return true;
+}
