+    Value rankZeroShift = Torch::createRank0Tensor(
+        rewriter, op.getLoc(), inputType, op->getOperand(1));
+    Value broadcastShift = Torch::AtenBroadcastToOp::create(
+        rewriter, op.getLoc(), inputType, rankZeroShift, size);
+    // TorchToLinalg lowers this registered signed tensor/tensor operation to
+    // arith::ShLIOp (arith.shli), discarding high bits in two's complement.
+    rewriter.replaceOpWithNewOp<Torch::AtenBitwiseLeftShiftTensorOp>(
+        op, resultType, op->getOperand(0), broadcastShift);
