+    if (countValue < 0)
+      return fail(op, "shift_contract:negative_shift");
+    if (countValue > 62)
+      return fail(op, "shift_contract:greater_than_sixty_two");
+    rewriter.setInsertionPoint(op);
+    auto sizeListType =
