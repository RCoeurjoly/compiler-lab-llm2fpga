From: LLM2FPGA diagnostics
Subject: [PATCH] xilinx: serialize chipdb-qualified PIP identity without copying RelPtr PODs

Wire endpoints cannot distinguish parallel clock selector PIPs. In addition,
the old getPipName copied PODs containing self-relative pointers, invalidating
their pointer bases. Emit a tile name plus PIP index instead. These identities
are specific to the pinned chipdb; old name parsers remain for compatibility.
Ambiguous legacy arrows still fail closed until independently recovered.

diff --git a/xilinx/arch.cc b/xilinx/arch.cc
--- a/xilinx/arch.cc
+++ b/xilinx/arch.cc
@@ -286,7 +286,24 @@ PipId Arch::getPipByName(IdString name) const
     setup_byname();
 
     const std::string &s = name.str(this);
-    if (s.substr(0, 8) == "SITEPIP/") {
+    if (s.substr(0, 6) == "PIPID/") {
+        const auto parts = split_identifier_name(s.substr(6));
+        const auto tile = tile_by_name.find(parts.first);
+        if (tile == tile_by_name.end())
+            log_error("Unknown PIPID tile in '%s'\n", s.c_str());
+        size_t used = 0;
+        int index = -1;
+        try {
+            index = std::stoi(parts.second, &used);
+        } catch (const std::exception &) {
+            log_error("Invalid PIPID index in '%s'\n", s.c_str());
+        }
+        const auto &info = chip_info->tile_types[chip_info->tile_insts[tile->second].type];
+        if (used != parts.second.size() || index < 0 || index >= info.num_pips)
+            log_error("Out-of-range PIPID index in '%s'\n", s.c_str());
+        ret.tile = tile->second;
+        ret.index = index;
+    } else if (s.substr(0, 8) == "SITEPIP/") {
         auto sp2 = split_identifier_name(s.substr(8));
         int tile, site;
         std::tie(tile, site) = site_by_name.at(sp2.first);
@@ -327,7 +346,7 @@ PipId Arch::getPipByName(IdString name) const
         if (src == WireId() || dst == WireId())
             log_error("Invalid wire-to-wire PIP name '%s'\n", s.c_str());
         for (PipId pip : getPipsDownhill(src)) {
-            if (getPipDstWire(pip) != dst || getPipName(pip) != name)
+            if (getPipDstWire(pip) != dst)
                 continue;
             if (ret != PipId() && ret != pip)
                 log_error("Ambiguous wire-to-wire PIP name '%s'\n", s.c_str());
@@ -343,20 +360,9 @@ IdString Arch::getPipName(PipId pip) const
 {
     NPNR_ASSERT(pip != PipId());
-    auto loc_info  = locInfo(pip);
-    auto pip_data  = loc_info.pip_data[pip.index];
-    auto tile_inst = chip_info->tile_insts[pip.tile];
-    auto site      = pip_data.site;
-    auto bel       = pip_data.bel;
-
-    if (site != -1 && pip_data.flags == PIP_SITE_INTERNAL && bel != -1) {
-        return id(std::string("SITEPIP/") +
-                    tile_inst.site_insts[site].name.get() +
-                    std::string("/") + IdString(bel).str(this) + "/" +
-                    IdString(loc_info.wire_data[pip_data.src_index].name).str(this));
-    } else {
-        return id(getWireName(getPipSrcWire(pip)).str(this) + "->" +
-                  getWireName(getPipDstWire(pip)).str(this));
-    }
+    // Never copy PODs containing self-relative pointers. A tile-qualified
+    // index preserves parallel selector identity for this exact chipdb.
+    return id(std::string("PIPID/") + chip_info->tile_insts[pip.tile].name.get() +
+              "/" + std::to_string(pip.index));
 }
 
 void Arch::setup_pip_blacklist()
diff --git a/common/command.cc b/common/command.cc
--- a/common/command.cc
+++ b/common/command.cc
@@ -352,6 +352,9 @@ int CommandHandler::exec()
     if (vm.count("write")) {
         std::string filename = vm["write"].as<std::string>();
         std::ofstream f(filename);
+        // A no-place/no-route reload must serialize the actual imported
+        // resources, not copy potentially obsolete ROUTING attributes.
+        ctx->archInfoToAttributes();
         if (!write_json_file(f, filename, ctx.get()))
             log_error("Saving design failed.\n");
     }
