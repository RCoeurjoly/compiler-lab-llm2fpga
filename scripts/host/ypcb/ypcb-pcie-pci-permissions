#!/usr/bin/env bash
set -euo pipefail

# Executed by udev as root.  This is deliberately narrower than a generic
# PCI recovery tool: it accepts only the fixed YPCB endpoint and enables only
# PCI memory and bus-master decoding after an FPGA SRAM/BPI reprogramming.
DEVPATH_ARG="${1:-}"
SYSFS_ROOT="/sys"
ENDPOINT_BDF="0000:42:00.0"
READY_TIMEOUT_SECONDS="${TASK6_PCIE_READY_TIMEOUT_SECONDS:-30}"

fail() {
  echo "ypcb-pcie-pci-permissions: $*" >&2
  exit 1
}

[[ -n "$DEVPATH_ARG" ]] || fail "missing udev devpath argument"
[[ "$DEVPATH_ARG" == /devices/* ]] || fail "refusing non-device devpath: $DEVPATH_ARG"
ENDPOINT_DIR="${SYSFS_ROOT}${DEVPATH_ARG}"
[[ "$(basename "$ENDPOINT_DIR")" == "$ENDPOINT_BDF" ]] || fail "refusing non-Task6 endpoint: $ENDPOINT_DIR"
[[ -d "$ENDPOINT_DIR" ]] || fail "missing endpoint: $ENDPOINT_DIR"

read_attr() {
  local name="$1" value
  [[ -f "$ENDPOINT_DIR/$name" ]] || fail "missing endpoint attribute: $name"
  value="$(<"$ENDPOINT_DIR/$name")"
  printf '%s' "${value,,}"
}

RESOURCE0="$ENDPOINT_DIR/resource0"
ready=0
for ((attempt = 0; attempt < READY_TIMEOUT_SECONDS; attempt++)); do
  if [[ "$(read_attr vendor)" == 0x10ee \
        && "$(read_attr device)" == 0x0480 \
        && "$(read_attr subsystem_vendor)" == 0x10ee \
        && "$(read_attr subsystem_device)" == 0xabcd \
        && -e "$RESOURCE0" ]]; then
    resource_line="$(head -n 1 "$ENDPOINT_DIR/resource" 2>/dev/null || true)"
    if [[ "$resource_line" =~ ^0x[0-9a-f]+[[:space:]]+0x[0-9a-f]+[[:space:]]+0x[0-9a-f]+$ ]]; then
      ready=1
      break
    fi
  fi
  sleep 1
done
(( ready == 1 )) || fail "endpoint identity/BAR did not stabilize within ${READY_TIMEOUT_SECONDS}s"

# BAR access is intentionally granted only after identity, BAR assignment,
# and PCI decode have been validated.  The user is already a member of the
# established plugdev group used by the Digilent programmer.
getent group plugdev >/dev/null || fail "missing plugdev group"
chmod 0660 "$RESOURCE0" || echo "warning: cannot set BAR0 mode" >&2
if command -v setfacl >/dev/null 2>&1; then
  if ! setfacl -m u:roland:rw "$RESOURCE0"; then
    echo "warning: cannot grant BAR0 ACL; trying group access" >&2
    chgrp plugdev "$RESOURCE0" || true
  fi
else
  chgrp plugdev "$RESOURCE0" || true
fi

command_before="$(/usr/bin/setpci -s "$ENDPOINT_BDF" COMMAND 2>/dev/null || true)"
[[ "$command_before" =~ ^[0-9A-Fa-f]{4}$ ]] || fail "unreadable endpoint COMMAND"
command_after="$(printf '%04x' $((0x$command_before | 0x0006)))"
if [[ "${command_before,,}" != "$command_after" ]]; then
  /usr/bin/setpci -s "$ENDPOINT_BDF" "COMMAND=$command_after"
fi
command_check="$(/usr/bin/setpci -s "$ENDPOINT_BDF" COMMAND 2>/dev/null || true)"
[[ "$command_check" =~ ^[0-9A-Fa-f]{4}$ ]] || fail "endpoint COMMAND became unreadable"
(( (0x$command_check & 0x0006) == 0x0006 )) || fail "endpoint memory/bus-master decode did not stick"
